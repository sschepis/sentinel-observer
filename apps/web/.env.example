# Observer server configuration — loaded at boot from apps/web/.env by the
# server (and by `npm run dev:all`, which prints the effective values).
# An explicit variable in the shell wins over this file.

# ── Readout arm (docs/NULL_ARMS.md, TASKS.md #10–12) ─────────────────────────
# The null-model benchmark showed the oscillator-field similarity term does not
# help recall: the current design scores memories by prime-signature overlap
# alone. Every confidence gate was refitted for that arm; the two must match
# (the server refuses a gates file fitted for a different arm). Stored traces
# are never re-encoded by these — they are readout switches.
OBSERVER_SMF_WEIGHT=0
OBSERVER_GATES_FILE=../../bench/calibration/conversation-gates-smf-off.json

# ── Training material (docs/CURRICULUM.md) ───────────────────────────────────
# The corpus directory of JSONL sources the classroom ingests under its budget
# (npm run fetch-conceptnet, npm run fetch-hf). Shuffle a ConceptNet file the
# server has not yet ingested: npm run shuffle-corpus -- corpus/conceptnet.en.jsonl
OBSERVER_CORPUS=corpus

# ── Working store ────────────────────────────────────────────────────────────
# json (default) or sqlite (migrates the JSON files once; recommended for the
# live record). Data directory: OBSERVER_DATA (default ./data).
# OBSERVER_STORE=sqlite

# ── Chaperone (LLM) ──────────────────────────────────────────────────────────
# Answers the observer's gaps, proposes exchanges, and grades compositions —
# its grades count only while `npm run grader-check` trusts it, so use an
# INSTRUCTION-TUNED model that returns the grade schema.
OBSERVER_CHAPERONE_ENDPOINT=http://127.0.0.1:1234/v1
OBSERVER_CHAPERONE_MODEL=<an instruct model served by LM Studio>
# LM Studio does not require a key; set one only if your endpoint does.
# OBSERVER_CHAPERONE_KEY=
# Enable topic research through the chaperone (R17):
# OBSERVER_RESEARCH_TOPICS=1

# ── Corpus fetching (npm run fetch-hf) ───────────────────────────────────────
# A Hugging Face token raises the datasets-server rate limits. Optional; never
# pass it on the command line.
# HF_TOKEN=hf_...
