# Observer server — chaperone (LLM) configuration.
# Loaded at boot by the server; overridable by explicit env vars / CLI flags.
OBSERVER_CHAPERONE_ENDPOINT=http://127.0.0.1:1234/v1
OBSERVER_CHAPERONE_MODEL=dirty-muse-writer-v01-uncensored-erotica-nsfw-i1
# LM Studio does not require a key; set one only if your endpoint does.
# OBSERVER_CHAPERONE_KEY=
# Enable topic research through the chaperone (R17):
# OBSERVER_RESEARCH_TOPICS=1

# Corpus fetching (npm run fetch-hf): a Hugging Face token raises the rate
# limits of the datasets-server API. Optional; never pass it on the command line.
# HF_TOKEN=hf_...
