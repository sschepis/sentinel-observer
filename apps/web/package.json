{
  "name": "@sschepis/sentinel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "preview": "vite preview",
    "train": "tsx src/cli/train.ts",
    "pretrain": "npm run build --workspace @sschepis/sentient-core",
    "scale-bench": "tsx src/cli/scale-bench.ts",
    "council-bench": "tsx src/cli/council-bench.ts",
    "drill-bench": "tsx src/cli/drill-bench.ts",
    "rules-report": "tsx src/cli/rules-report.ts",
    "constants-report": "tsx src/cli/constants-report.ts",
    "calibration-bench": "tsx src/cli/calibration-bench.ts",
    "cde-bench": "tsx src/cli/cde-bench.ts",
    "path-entropy-bench": "tsx src/cli/path-entropy-bench.ts",
    "polysemy-bench": "tsx src/cli/polysemy-bench.ts",
    "signature-bench": "tsx src/cli/signature-bench.ts",
    "smf-width-bench": "tsx src/cli/smf-width-bench.ts",
    "p1-relations-bench": "tsx src/cli/p1-relations-bench.ts",
    "ask-audit": "tsx src/cli/ask-audit.ts",
    "grounded-bench": "tsx src/cli/grounded-bench.ts",
    "sweep-bench": "tsx src/cli/contradiction-sweep-bench.ts",
    "classroom": "tsx src/cli/autonomous-classroom.ts",
    "test:bench": "jest --testPathPatterns \"recallBenchmark|scaleBenchmark|scale20kBenchmark|fullDeckPruning|ciGates|semanticRecall|clusterMomentBenchmark|serverParity|phaseFrameBenchmark|primingBenchmark\" --testPathIgnorePatterns /dev/null/",
    "competition-bench": "jest --testPathPatterns \"competitionBenchmark\" --testPathIgnorePatterns /dev/null/",
    "falsifier-bench": "jest --testPathPatterns \"centerSketchesFalsifier\" --testPathIgnorePatterns /dev/null/",
    "test:sparse-bench": "jest --testPathPatterns sparseExcitationBenchmark --testPathIgnorePatterns /dev/null/",
    "template-bench": "tsx src/cli/template-bench.ts",
    "chat": "tsx src/cli/chat.ts",
    "read": "tsx src/cli/read.ts",
    "fetch-curriculum": "tsx src/cli/fetch-curriculum.ts",
    "margin-bench": "tsx src/cli/margin-bench.ts",
    "server": "tsx src/server/main.ts"
  },
  "dependencies": {
    "@aleph-ai/tinyaleph": "^1.8.2",
    "@sschepis/sentient-core": "file:../../packages/sentient-core",
